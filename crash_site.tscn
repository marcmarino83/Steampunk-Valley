[node name="ShipsLog" type="StaticBody3D" parent="HullIntact"]
position = Vector3(1.4, 0.74, -2.6)
rotation_degrees = Vector3(0, -20, 0)
script = ExtResource("2_note")
title = "Ship's Log"
text = "Log of the Brass Lark, Captain Ilsa Wren.

Day 9 since the capital fell. Forty souls aboard a ship built for twelve. We fly west, away from the light.

Day 11. The aether cells flicker gold, then dim. Our engineer swears they're draining faster than they should.

Day 12. Something below is following us. When we turn, it turns.

Final entry. The cells are failing. I'm bringing her down in the valley ahead. If anyone finds this, don't"

